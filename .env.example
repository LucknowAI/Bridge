# ==============================================================
# Copy to .env and fill in.  docker-compose reads .env automatically.
# Nothing here is exposed to the browser — there are no NEXT_PUBLIC_* vars.
# ==============================================================

# ── App ───────────────────────────────────────────────────────
# Public origin. Must match the Keycloak client's redirect URI.
APP_BASE_URL=http://localhost:3000
WEB_PORT=3000
DEFAULT_EVENT_SLUG=demo

# Encrypts the session cookie. REQUIRED, min 32 chars.
#   openssl rand -base64 48
SESSION_SECRET=

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=matchmaker
POSTGRES_PASSWORD=matchmaker
POSTGRES_DB=matchmaker
POSTGRES_PORT=5432

# Used by scripts run on the HOST (migrate/seed/import).
# Inside docker-compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgres://matchmaker:matchmaker@localhost:5432/matchmaker
# disable (local, no TLS) | require (encrypted, unverified) | verify (encrypted,
# certificate checked against DATABASE_CA_CERT or DATABASE_CA_CERT_FILE).
# Production refuses anything but verify for a remote database.
DATABASE_SSL=disable
# DATABASE_CA_CERT_FILE=/etc/ssl/certs/rds-global-bundle.pem

# Deployed only: the migration task creates these least-privilege logins
# (packages/db/src/ensure-roles.ts); web and worker then use the runtime one.
# DATABASE_RUNTIME_USER=app_runtime
# DATABASE_RUNTIME_PASSWORD=
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_DB_PASSWORD=

# ── Keycloak ──────────────────────────────────────────────────
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Issuer as the BROWSER sees it — also the expected `iss` claim.
KEYCLOAK_ISSUER=http://localhost:8080/realms/match-maker
# Issuer as the APP sees it for server-to-server calls. Host processes use
# localhost; docker-compose overrides it with http://keycloak:8080 for the web container.
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8080/realms/match-maker
KEYCLOAK_CLIENT_ID=match-maker-web
KEYCLOAK_CLIENT_SECRET=dev-client-secret-change-me
KEYCLOAK_GOOGLE_IDP_ALIAS=google

# ── Google sign-in ────────────────────────────────────────────
# From Google Cloud Console > APIs & Services > Credentials.
# Authorised redirect URI must be:
#   http://localhost:8080/realms/match-maker/broker/google/endpoint
# Leave blank to develop with the e-mail-code path only; the login page shows
# "Sign in with Google" only when GOOGLE_CLIENT_ID is set. After changing these
# (or KEYCLOAK_CLIENT_SECRET) on an existing realm, run: npm run keycloak:sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Resend (login e-mails) ────────────────────────────────────
# The web app refuses to start without a key unless EMAIL_DEV_FALLBACK=true.
# EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Mr. Bridge <onboarding@resend.dev>

# With no RESEND_API_KEY, print login e-mails to the server log instead of
# sending them. Local development only — never set this in a deployed
# environment, or logins will silently never arrive.
EMAIL_DEV_FALLBACK=true

# Code + magic-link lifetime and throttling.
OTP_TTL_SECONDS=600
OTP_MAX_PER_WINDOW=5
OTP_RATE_WINDOW_SECONDS=900

# Seconds the worker waits before refreshing other people's matches after a
# profile change, so bursts of changes coalesce (default 120).
# MATCH_REFRESH_DELAY_SECONDS=120

# Proxies in front of the web app that append to X-Forwarded-For (1 behind
# the AWS ALB). 0 trusts no header, so per-IP login limits are skipped locally.
TRUSTED_PROXY_HOPS=0

# ── Gemini (matchmaking) ──────────────────────────────────────
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=gemini
# Optional self-hosted BGE endpoint, used when EMBEDDING_PROVIDER=local.
LOCAL_BGE_URL=
# Optional shared Redis retrieval cache. Docker uses PostgreSQL when these are blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Local convenience ─────────────────────────────────────────
# Seed demo attendees after migrating. Never enable against production.
SEED_ON_MIGRATE=true
