{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "APP_BASE_URL",
    "DEFAULT_EVENT_SLUG",
    "SESSION_SECRET",
    "SESSION_COOKIE_NAME",
    "SESSION_MAX_AGE",
    "DATABASE_URL",
    "DATABASE_SSL",
    "DATABASE_CA_CERT",
    "DATABASE_POOL_MAX",
    "KEYCLOAK_ISSUER",
    "KEYCLOAK_INTERNAL_ISSUER",
    "KEYCLOAK_CLIENT_ID",
    "KEYCLOAK_CLIENT_SECRET",
    "KEYCLOAK_GOOGLE_IDP_ALIAS",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "EMAIL_DEV_FALLBACK",
    "OTP_TTL_SECONDS",
    "OTP_MAX_PER_WINDOW",
    "OTP_RATE_WINDOW_SECONDS",
    "OTP_PEPPER",
    "GEMINI_API_KEY",
    "GEMINI_LLM_MODEL",
    "EMBEDDING_PROVIDER",
    "LOCAL_BGE_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
