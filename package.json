{
  "name": "match-maker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:import": "tsx tools/import-attendees.ts",
    "worker": "tsx packages/db/workers/worker.ts",
    "org:init": "tsx tools/bootstrap-organization.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web",
    "keycloak:wait": "tsx tools/wait-for-keycloak.ts",
    "keycloak:sync": "tsx tools/sync-keycloak.ts",
    "account:disable": "tsx tools/manage-account.ts disable",
    "account:enable": "tsx tools/manage-account.ts enable",
    "account:revoke-sessions": "tsx tools/manage-account.ts revoke-sessions",
    "account:erase": "tsx tools/manage-account.ts erase",
    "jobs:failed": "tsx tools/manage-jobs.ts failed",
    "jobs:retry": "tsx tools/manage-jobs.ts retry",
    "models:usage": "tsx tools/model-usage.ts",
    "capacity:check": "tsx tools/capacity-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
